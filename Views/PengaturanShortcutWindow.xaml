<Window x:Class="KasirKu.Views.PengaturanShortcutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pengaturan Shortcut Keyboard Kasir" Height="400" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <!-- Membungkus dengan Border untuk menggantikan Padding pada Grid -->
    <Border Padding="20" Background="#F8F9FA">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Pengaturan Shortcut Kasir" FontSize="18" FontWeight="Bold" Foreground="#0D6EFD" Margin="0,0,0,15"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ContainerShortcut">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Fokus Pencarian Produk" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbFokusPencarian" Grid.Column="1" Padding="5"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Hold / Tahan Transaksi" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbHold" Grid.Column="1" Padding="5"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Buka Transaksi Hold" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbResume" Grid.Column="1" Padding="5"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Batal Transaksi" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbBatal" Grid.Column="1" Padding="5"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Proses Bayar" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbBayar" Grid.Column="1" Padding="5"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Batal" Width="90" Height="35" Click="BtnBatal_Click" Margin="0,0,10,0"/>
                <Button Content="Simpan" Width="90" Height="35" Background="#0D6EFD" Foreground="White" FontWeight="Bold" Click="BtnSimpan_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>