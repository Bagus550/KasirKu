<UserControl x:Class="KasirKu.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:KasirKu.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:LoginViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="500" d:DesignWidth="400">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="#F8F9FA">
        <Border Width="340" Height="380" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Padding="25">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="KasirKu POS" FontSize="24" FontWeight="Bold" Foreground="#0D6EFD" HorizontalAlignment="Center"/>
                <TextBlock Text="Silakan login untuk melanjutkan" FontSize="12" Foreground="#6C757D" HorizontalAlignment="Center" Margin="0,5,0,25"/>

                <!-- USERNAME FIELD -->
                <TextBlock Text="Username" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="8" FontSize="14" Margin="0,0,0,15"/>

                <!-- PASSWORD FIELD WITH TOGGLE -->
                <TextBlock Text="Password" FontWeight="Bold" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. PasswordBox (Mode Tersembunyi) -->
                    <PasswordBox x:Name="TxtPasswordBox"
                                 Grid.Column="0"
                                 Padding="8" 
                                 FontSize="14"
                                 PasswordChanged="TxtPasswordBox_PasswordChanged"/>

                    <!-- 2. TextBox (Mode Terlihat) -->
                    <TextBox x:Name="TxtVisiblePassword"
                             Grid.Column="0"
                             Padding="8" 
                             FontSize="14"
                             Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                             TextChanged="TxtVisiblePassword_TextChanged"/>

                    <!-- 3. Tombol Toggle Mata (Eye Icon) -->
                    <ToggleButton Grid.Column="1"
                                  IsChecked="{Binding IsPasswordVisible, Mode=TwoWay}"
                                  Width="38" Height="35"
                                  Margin="5,0,0,0"
                                  Background="Transparent"
                                  BorderBrush="#CED4DA"
                                  Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="4">
                                    <Viewbox Width="18" Height="18">
                                        <!-- Icon Mata Terbuka -->
                                        <Path x:Name="EyeIcon" 
                                              Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" 
                                              Fill="#6C757D"/>
                                    </Viewbox>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <!-- Icon Mata Dicoret (Hide Password) -->
                                        <Setter TargetName="EyeIcon" Property="Data" Value="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.17c0-1.66-1.34-3-3-3l-.17.02z"/>
                                        <Setter TargetName="EyeIcon" Property="Fill" Value="#0D6EFD"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>

                <!-- TOMBOL LOGIN -->
                <Button Content="MASUK" Command="{Binding LoginCommand}" 
                        Height="40" Background="#0D6EFD" Foreground="White" FontWeight="Bold" FontSize="14"
                        IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>