<Window x:Class="KasirKu.Views.ClockInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clock-In Shift Kasir" 
        Width="420" 
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize">

    <Border Background="#F8F9FA" Padding="20">
        <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#DEE2E6" BorderThickness="1">
            <StackPanel>
                <!-- Judul Utama -->
                <TextBlock Text="Mulai Shift Kasir" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="#0D6EFD" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,15"/>

                <!-- Info Kasir -->
                <TextBlock Text="{Binding NamaKasir, StringFormat='Kasir: {0}'}" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Foreground="#495057" 
                           Margin="0,0,0,15"/>

                <!-- Dropdown Pilih Shift -->
                <TextBlock Text="Pilih Shift Kerja" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding DaftarShift}" 
                          SelectedItem="{Binding ShiftTerpilih}" 
                          DisplayMemberPath="NamaShift" 
                          Padding="8,6" 
                          FontSize="14" 
                          Margin="0,0,0,15"/>

                <!-- Input Modal Awal -->
                <TextBlock Text="Input Modal Awal (Rp)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding ModalAwalText, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="8,6" 
                         FontSize="14" 
                         Margin="0,0,0,20"/>

                <!-- Tombol Aksi -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Batal" 
                            Click="BtnBatal_Click" 
                            Width="90" Height="36" 
                            Margin="0,0,10,0" 
                            Background="#6C757D" 
                            Foreground="White" 
                            FontWeight="Bold"/>
                    <Button Content="Mulai Shift" 
                            Command="{Binding MulaiShiftCommand}" 
                            Width="110" Height="36" 
                            Background="#0D6EFD" 
                            Foreground="White" 
                            FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</Window>