<Window x:Class="KasirKu.Views.ClockInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buka Shift Kasir" Height="300" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Buka Shift Kasir" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- Tambahkan x:Name="TxtKasirInfo" di sini -->
            <TextBlock x:Name="TxtKasirInfo" Text="Kasir: -" Foreground="Gray" Margin="0,0,0,15"/>

            <TextBlock Text="Masukkan Modal Awal Kas (Rp):" FontWeight="SemiBold"/>

            <!-- Tambahkan x:Name="TxtModalAwal" di sini -->
            <TextBox x:Name="TxtModalAwal" Height="35" FontSize="14" VerticalContentAlignment="Center" Margin="0,5,0,20" Text="0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Buka Shift" Width="120" Height="35" Background="#28A745" Foreground="White" 
                        Click="BtnBukaShift_Click" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>