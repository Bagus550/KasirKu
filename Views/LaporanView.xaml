<UserControl x:Class="KasirKu.Views.LaporanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:KasirKu.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:LaporanViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="600" d:DesignWidth="950">

    <UserControl.DataContext>
        <vm:LaporanViewModel />
    </UserControl.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. BARIS FILTER TANGGAL -->
        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Dari Tanggal:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding TanggalAwal}" Width="130" Margin="0,0,15,0"/>

                <TextBlock Text="Sampai Tanggal:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding TanggalAkhir}" Width="130" Margin="0,0,15,0"/>

                <Button Content="Tampilkan" Command="{Binding MuatLaporanCommand}" 
                        Padding="12,5" Background="#0D6EFD" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>

                <Button Content="Hari Ini" Command="{Binding FilterHariIniCommand}" 
                        Padding="10,5" Background="#6C757D" Foreground="White" Margin="0,0,5,0"/>

                <Button Content="Bulan Ini" Command="{Binding FilterBulanIniCommand}" 
                        Padding="10,5" Background="#6C757D" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- 2. BARIS CARD RINGKASAN (OMZET, TRANSAKSI, ITEM) -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Omzet -->
            <Border Grid.Column="0" Background="#198754" CornerRadius="5" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="TOTAL OMZET" Foreground="White" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalOmzet, StringFormat=Rp \{0:N0\}}" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Jumlah Transaksi -->
            <Border Grid.Column="1" Background="#0D6EFD" CornerRadius="5" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="TOTAL TRANSAKSI" Foreground="White" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalJumlahTransaksi, StringFormat=\{0\} Transaksi}" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Item Terjual -->
            <Border Grid.Column="2" Background="#FFC107" CornerRadius="5" Padding="15">
                <StackPanel>
                    <TextBlock Text="TOTAL ITEM TERJUAL" Foreground="#212529" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalItemTerjual, StringFormat=\{0\} Pcs}" Foreground="#212529" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. DETAIL LAPORAN: TABEL NOTA (KIRI) & RINCIAN ITEM (KANAN) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tabel Riwayat Nota -->
            <GroupBox Grid.Column="0" Header="Daftar Nota Transaksi" Margin="0,0,10,0" FontWeight="Bold">
                <DataGrid ItemsSource="{Binding DaftarTransaksi}" SelectedItem="{Binding TransaksiTerpilih}" 
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No. Nota" Binding="{Binding NomorNota}" Width="*"/>
                        <DataGridTextColumn Header="Waktu" Binding="{Binding Tanggal, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="120"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalHarga, StringFormat=N0}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Rincian Item Nota Terpilih -->
            <GroupBox Grid.Column="1" Header="Rincian Barang Dipilih" FontWeight="Bold">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{Binding TransaksiTerpilih.NomorNota, TargetNullValue='Pilih nota untuk lihat rincian'}" 
                                   Foreground="#0D6EFD" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding TransaksiTerpilih.DetailTransaksi}" 
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nama Produk" Binding="{Binding NamaProduk}" Width="*"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Jumlah}" Width="45"/>
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=N0}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>