<UserControl x:Class="KasirKu.Views.LaporanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:KasirKu.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:LaporanViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="850" d:DesignWidth="950">

    <!-- ScrollViewer agar tampilan tidak bertumpuk jika resolusi layar terbatas -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="15">

            <!-- 1. BARIS FILTER TANGGAL & ACTION BUTTONS -->
            <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,5">
                            <TextBlock Text="Dari:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
                            <DatePicker SelectedDate="{Binding TanggalAwal}" Width="115"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,10,5">
                            <TextBlock Text="Sampai:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
                            <DatePicker SelectedDate="{Binding TanggalAkhir}" Width="115"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Button Content="Tampilkan" Command="{Binding MuatLaporanCommand}" 
                                    Padding="8,4" Background="#0D6EFD" Foreground="White" FontWeight="Bold" Margin="0,0,5,0"/>

                            <Button Content="Hari Ini" Command="{Binding FilterHariIniCommand}" 
                                    Padding="8,4" Background="#6C757D" Foreground="White" Margin="0,0,5,0"/>

                            <Button Content="Bulan Ini" Command="{Binding FilterBulanIniCommand}" 
                                    Padding="8,4" Background="#6C757D" Foreground="White"/>
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button Content="📊 Export CSV" Command="{Binding ExportCsvCommand}" 
                                Background="#198754" Foreground="White" FontWeight="Bold" Padding="10,5" Margin="0,0,8,0"/>

                        <Button Content="💾 Backup DB" Command="{Binding BackupDatabaseCommand}" 
                                Background="#0D6EFD" Foreground="White" FontWeight="Bold" Padding="10,5"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. BARIS CARD RINGKASAN -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#198754" CornerRadius="5" Padding="15" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL OMZET" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalOmzet, StringFormat=Rp \{0:N0\}}" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#0D6EFD" CornerRadius="5" Padding="15" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL TRANSAKSI" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalJumlahTransaksi, StringFormat=\{0\} Transaksi}" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#FFC107" CornerRadius="5" Padding="15">
                    <StackPanel>
                        <TextBlock Text="TOTAL ITEM TERJUAL" Foreground="#212529" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalItemTerjual, StringFormat=\{0\} Pcs}" Foreground="#212529" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. DETAIL LAPORAN: TABEL NOTA & RINCIAN ITEM (Diberi Height Pasti) -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tabel Riwayat Nota -->
                <GroupBox Grid.Column="0" Header="Daftar Nota Transaksi" Margin="0,0,10,0" FontWeight="Bold" Padding="5">
                    <DataGrid ItemsSource="{Binding DaftarTransaksi}" SelectedItem="{Binding TransaksiTerpilih}" 
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Height="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No. Nota" Binding="{Binding NomorNota}" Width="*"/>
                            <DataGridTextColumn Header="Waktu" Binding="{Binding Tanggal, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="120"/>
                            <DataGridTextColumn Header="Kasir" Binding="{Binding NamaKasir}" Width="*"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalHarga, StringFormat=N0}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <!-- Rincian Item Nota Terpilih -->
                <GroupBox Grid.Column="1" Header="Rincian Barang Dipilih" FontWeight="Bold" Padding="5">
                    <Grid Height="220">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding TransaksiTerpilih.NomorNota, TargetNullValue='Pilih nota untuk lihat rincian'}" 
                                   Foreground="#0D6EFD" FontSize="13" FontWeight="Bold" Margin="0,0,0,5"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding TransaksiTerpilih.DetailTransaksi}" 
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nama Produk" Binding="{Binding NamaProduk}" Width="*"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Jumlah}" Width="45"/>
                                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=N0}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </GroupBox>
            </Grid>

            <!-- 4. WIDGET TAMBAHAN: TOP PRODUK TERLARIS & ALERT STOK KRITIS -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Widget Top Produk Terlaris -->
                <GroupBox Grid.Column="0" Header="🔥 Top 5 Produk Terlaris" Margin="0,0,10,0" FontWeight="Bold" Padding="5">
                    <DataGrid ItemsSource="{Binding ProdukTerlaris}" AutoGenerateColumns="False" IsReadOnly="True" Height="150" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nama Produk" Binding="{Binding NamaProduk}" Width="*"/>
                            <DataGridTextColumn Header="Terjual" Binding="{Binding TotalTerjual, StringFormat=\{0\} Pcs}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <!-- Widget Stok Kritis / Menipis -->
                <GroupBox Grid.Column="1" Header="⚠️ Alert Stok Menipis / Habis" FontWeight="Bold" Padding="5">
                    <DataGrid ItemsSource="{Binding StokKritis}" AutoGenerateColumns="False" IsReadOnly="True" Height="150" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Produk" Binding="{Binding Nama}" Width="*"/>
                            <DataGridTextColumn Header="Sisa Stok" Binding="{Binding Stok}" Width="80"/>
                            <DataGridTextColumn Header="Min. Stok" Binding="{Binding StokMinimum}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>