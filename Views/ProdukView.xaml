<UserControl x:Class="KasirKu.Views.ProdukView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:KasirKu.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ProdukViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <!-- KIRI: DataGrid & Pencarian -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Bar -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Cari:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
                <TextBox Width="200" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Padding="4"/>
                <Button Content="Cari" Command="{Binding MuatDataProdukCommand}" Width="70" Padding="4"/>
            </StackPanel>

            <!-- Tabel Produk -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding DaftarProduk}" SelectedItem="{Binding SelectedProduk}" 
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="80"/>
                    <DataGridTextColumn Header="Nama Produk" Binding="{Binding Nama}" Width="*"/>
                    <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="100"/>
                    <DataGridTextColumn Header="Harga Jual" Binding="{Binding HargaJual, StringFormat=N0}" Width="100"/>
                    <DataGridTextColumn Header="Stok" Binding="{Binding Stok}" Width="60"/>
                    <DataGridTemplateColumn Header="Aksi" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Hapus" Command="{Binding DataContext.HapusProdukCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding}" Background="#FFD9534F" Foreground="White"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- KANAN: Form Input / Edit Produk -->
        <Border Grid.Column="1" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="5" Padding="15">
            <StackPanel>
                <TextBlock Text="Form Input Produk" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                <TextBlock Text="Nama Produk *" Margin="0,5,0,2"/>
                <TextBox Text="{Binding SelectedProduk.Nama, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>

                <TextBlock Text="SKU / Barcode" Margin="0,10,0,2"/>
                <TextBox Text="{Binding SelectedProduk.SKU, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>

                <TextBlock Text="Kategori" Margin="0,10,0,2"/>
                <TextBox Text="{Binding SelectedProduk.Kategori, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Harga Beli" Margin="0,0,0,2"/>
                        <!-- Menggunakan LostFocus agar input kosong bisa di-handle dengan aman -->
                        <TextBox Text="{Binding SelectedProduk.HargaBeli, UpdateSourceTrigger=LostFocus, TargetNullValue='0', FallbackValue='0'}" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Harga Jual" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedProduk.HargaJual, UpdateSourceTrigger=LostFocus, TargetNullValue='0', FallbackValue='0'}" Padding="5"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Stok" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedProduk.Stok, UpdateSourceTrigger=LostFocus, TargetNullValue='0', FallbackValue='0'}" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Stok Min." Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedProduk.StokMinimum, UpdateSourceTrigger=LostFocus, TargetNullValue='0', FallbackValue='0'}" Padding="5"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Batal / Reset" Command="{Binding ResetFormCommand}" Width="124" Padding="6" Margin="0,0,8,0"/>
                    <Button Content="Simpan" Command="{Binding SimpanProdukCommand}" Width="90" Padding="6" Background="#FF0275D8" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>