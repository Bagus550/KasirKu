<UserControl x:Class="KasirKu.Views.KasirView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:KasirKu.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:KasirViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="600" d:DesignWidth="900"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <!-- KIRI: Scan Barcode, Keranjang Belanja, & Hold Section -->
        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Panel Input Barcode / SKU / Nama + AutoComplete Suggestion + Tombol Pengaturan -->
            <Border Grid.Row="0" Background="#E9ECEF" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Cari / Scan Barcode:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>

                    <ComboBox x:Name="cbBarcode"
                              Grid.Column="1"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              SelectedValuePath="Id"
                              Text="{Binding InputBarcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding DaftarSuggestionProduk}"
                              SelectedItem="{Binding SelectedProdukSuggestion, Mode=TwoWay}"
                              IsDropDownOpen="{Binding IsSuggestionOpen, Mode=TwoWay}"
                              PreviewKeyDown="ComboBox_PreviewKeyDown"
                              FontSize="14"
                              Padding="6"
                              VerticalContentAlignment="Center">

                        <ComboBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding TambahBarangCommand}"/>
                        </ComboBox.InputBindings>

                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <EventSetter Event="PreviewMouseDown" Handler="ComboBoxItem_PreviewMouseDown"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nama}" FontWeight="Bold" FontSize="13"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="SKU: " Foreground="Gray" FontSize="11"/>
                                            <TextBlock Text="{Binding SKU, TargetNullValue='-'}" Foreground="Gray" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="15,0,0,0">
                                        <TextBlock Text="{Binding HargaJual, StringFormat=Rp {0:N0}}" 
                                                   Foreground="#198754" 
                                                   FontWeight="Bold" 
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding Stok, StringFormat='Stok: {0}'}" 
                                                   Foreground="#0D6EFD" 
                                                   FontSize="11" 
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="2" Content="Tambah" Command="{Binding TambahBarangCommand}" 
                            Width="80" Margin="10,0,0,0" Padding="6" Background="#FF0275D8" Foreground="White" FontWeight="Bold"/>

                    <!-- Tombol Pengaturan Shortcut -->
                    <Button Grid.Column="3" Content="⚙️" Command="{Binding BukaPengaturanShortcutCommand}" 
                            ToolTip="Pengaturan Shortcut Keyboard" Width="38" Margin="8,0,0,0" Padding="6" 
                            Background="#6C757D" Foreground="White" FontWeight="Bold" FontSize="14"/>
                </Grid>
            </Border>

            <!-- Tabel Keranjang Belanja -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding Keranjang}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nama Barang" Binding="{Binding Produk.Nama}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Harga" Binding="{Binding HargaJual, StringFormat=N0}" Width="100" IsReadOnly="True"/>

                    <!-- Column Jumlah Barang -->
                    <DataGridTemplateColumn Header="Qty" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Jumlah, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=N0}" Width="110" IsReadOnly="True"/>

                    <!-- Tombol Hapus Item -->
                    <DataGridTemplateColumn Header="Aksi" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="X" Command="{Binding DataContext.HapusItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding}" Background="#FFD9534F" Foreground="White" FontWeight="Bold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Tombol Batal & Tombol Hold Transaksi -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Reset / Batal Transaksi" Command="{Binding BatalTransaksiCommand}" 
                        Padding="8,5" Background="#FF6C757D" Foreground="White" Margin="0,0,10,0"/>

                <Button Content="⏸️ Hold (Tahan Transaksi)" Command="{Binding HoldTransaksiCommand}" 
                        Padding="10,5" Background="#FFC107" Foreground="#212529" FontWeight="Bold"/>
            </StackPanel>

            <!-- Section Daftar Transaksi Di-Hold / Pending -->
            <GroupBox Grid.Row="3" Header="⏸️ Transaksi Ditahan (Pending)" Margin="0,15,0,0" FontWeight="Bold">
                <DataGrid ItemsSource="{Binding DaftarHold}" AutoGenerateColumns="False" IsReadOnly="True" Height="110" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID Hold" Binding="{Binding Id}" Width="80"/>
                        <DataGridTextColumn Header="Waktu" Binding="{Binding Waktu, StringFormat=\{0:HH:mm:ss\}}" Width="80"/>
                        <DataGridTextColumn Header="Items" Binding="{Binding Items.Count}" Width="60"/>
                        <DataGridTextColumn Header="Total Rp" Binding="{Binding TotalHarga, StringFormat=N0}" Width="100"/>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Lanjutkan" 
                                            Command="{Binding DataContext.ResumeTransaksiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#198754" Foreground="White" FontWeight="Bold" Padding="5,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <!-- KANAN: Total, Input Bayar, & Kembalian -->
        <Border Grid.Column="1" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="5" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="RINGKASAN PEMBAYARAN" FontSize="14" FontWeight="Bold" Foreground="#6C757D" Margin="0,0,0,15"/>

                <StackPanel Grid.Row="1">
                    <Border Background="#212529" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="TOTAL BELANJA" Foreground="#ADB5BD" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalHarga, StringFormat=Rp \{0:N0\}}" Foreground="#20C997" FontSize="28" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Uang Pembayaran (Rp)" FontWeight="Bold" Margin="0,5,0,2"/>
                    <TextBox Text="{Binding TotalBayar, UpdateSourceTrigger=PropertyChanged, StringFormat=N0, TargetNullValue='0'}" 
                             FontSize="20" FontWeight="Bold" Padding="5" Foreground="#0D6EFD" Margin="0,0,0,15"/>

                    <Border Background="#E9ECEF" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="KEMBALIAN" Foreground="#6C757D" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Kembalian, StringFormat=Rp \{0:N0\}}" Foreground="#0D6EFD" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="3" CornerRadius="5" ClipToBounds="True">
                    <Button Content="PROSES BAYAR (ENTER)" Command="{Binding ProsesBayarCommand}" 
                            Height="50" FontSize="16" FontWeight="Bold" Background="#198754" Foreground="White" VerticalAlignment="Bottom"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>