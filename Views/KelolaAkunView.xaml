<UserControl x:Class="KasirKu.Views.KelolaAkunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KasirKu.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#F8F9FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER PAGE -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15,12" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05" Color="Black"/>
            </Border.Effect>
            <Grid>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Manajemen Akun Kasir &amp; Admin" FontSize="18" FontWeight="Bold" Foreground="#212529"/>
                    <TextBlock Text="Tambah, perbarui, atau hapus akses pengguna aplikasi POS" FontSize="12" Foreground="#6C757D" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- FORM INPUT (KIRI) -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05" Color="Black"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <TextBlock Text="Form Pengguna" FontSize="15" FontWeight="SemiBold" Foreground="#343A40" Margin="0,0,0,15"/>

                        <!-- ID (Hidden / Display Only saat edit) -->
                        <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" Margin="0,0,0,10">
                            <TextBlock Text="ID User" FontSize="12" Foreground="#495057"/>
                            <TextBox Text="{Binding SelectedKasir.Id, Mode=OneWay}" IsReadOnly="True" Background="#E9ECEF" Padding="8,6" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- NAMA LENGKAP -->
                        <TextBlock Text="Nama Lengkap" FontSize="12" FontWeight="Medium" Foreground="#495057"/>
                        <TextBox Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4,0,12"/>

                        <!-- USERNAME -->
                        <TextBlock Text="Username" FontSize="12" FontWeight="Medium" Foreground="#495057"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4,0,12"/>

                        <!-- PASSWORD -->
                        <TextBlock Text="Password" FontSize="12" FontWeight="Medium" Foreground="#495057"/>
                        <PasswordBox x:Name="TxtPassword" Padding="8,6" Margin="0,4,0,2"/>
                        <TextBlock Text="*Kosongkan jika tidak ingin mengubah password saat edit" FontSize="10" Foreground="#8C8C8C" Margin="0,0,0,12"/>

                        <!-- ROLE -->
                        <TextBlock Text="Role / Hak Akses" FontSize="12" FontWeight="Medium" Foreground="#495057"/>
                        <ComboBox SelectedValue="{Binding SelectedRole, Mode=TwoWay}" SelectedValuePath="Content" Padding="8,6" Margin="0,4,0,20">
                            <ComboBoxItem Content="Kasir"/>
                            <ComboBoxItem Content="Admin"/>
                        </ComboBox>

                        <!-- TOMBOL AKSI FORM -->
                        <StackPanel Orientation="Vertical">
                            <Button Content="Simpan Akun" Command="{Binding SimpanCommand}" 
                                    CommandParameter="{Binding ElementName=TxtPassword}"
                                    Height="36" Background="#0D6EFD" Foreground="White" FontWeight="SemiBold"
                                    BorderThickness="0" Margin="0,0,0,8">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="Batal / Clear" Command="{Binding BatalCommand}" 
                                    Height="32" Background="#6C757D" Foreground="White" 
                                    BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- TABEL DAFTAR KASIR (KANAN) -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Daftar Pengguna Terdaftar" FontSize="15" FontWeight="SemiBold" Foreground="#343A40" Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding DaftarKasir}" SelectedItem="{Binding SelectedKasir}" 
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DEE2E6"
                              Background="Transparent" RowHeight="35" ColumnHeaderHeight="35">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Nama Lengkap" Binding="{Binding Nama}" Width="*"/>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="140"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>

                            <!-- Aksi Edit & Hapus -->
                            <DataGridTemplateColumn Header="Aksi" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Edit" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" Background="#FFC107" Foreground="#212529" 
                                                    Padding="10,2" Margin="0,0,5,0" BorderThickness="0"/>
                                            <Button Content="Hapus" Command="{Binding DataContext.HapusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" Background="#DC3545" Foreground="White" 
                                                    Padding="10,2" BorderThickness="0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>