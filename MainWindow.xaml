<Window x:Class="KasirKu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:KasirKu.Views"
        mc:Ignorable="d"
        Title="KasirKu - Aplikasi POS Desktop" Height="650" Width="1000" WindowStartupLocation="CenterScreen">

    <Grid>
        <TabControl Margin="5">
            <!-- Tab 1: Transaksi Kasir -->
            <TabItem Header=" 🛒 Kasir / POS " FontSize="14" FontWeight="Bold">
                <views:KasirView />
            </TabItem>

            <!-- Tab 2: Manajemen Produk -->
            <TabItem Header=" 📦 Data Produk " FontSize="14" FontWeight="Bold">
                <views:ProdukView />
            </TabItem>
        </TabControl>
    </Grid>
</Window>