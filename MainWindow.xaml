<Window x:Class="KasirKu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:KasirKu.Views"
        mc:Ignorable="d"
        Title="KasirKu - Aplikasi POS Desktop" Height="650" Width="1000" WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Tampilan Form Login (Muncul di awal) -->
        <views:LoginView x:Name="ViewLogin" />

        <!-- Tampilan Utam Tab Menu (Tersembunyi sebelum Login) -->
        <Grid x:Name="GridUtama" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Bar Atas Status Login -->
            <Border Grid.Row="0" Background="#212529" Padding="10">
                <Grid>
                    <TextBlock x:Name="TxtInfoUser" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="Logout" Click="BtnLogout_Click" HorizontalAlignment="Right" Padding="10,3" Background="#DC3545" Foreground="White"/>
                </Grid>
            </Border>

            <!-- Berikan x:Name pada TabControl -->
            <TabControl x:Name="TabUtama" Grid.Row="1" Margin="5">

                <!-- Tab 1: Transaksi Kasir -->
                <TabItem x:Name="TabKasir" Header=" 🛒 Kasir / POS " FontSize="14" FontWeight="Bold">
                    <views:KasirView x:Name="ViewKasir" />
                </TabItem>

                <!-- Tab 2: Laporan Penjualan -->
                <TabItem x:Name="TabLaporan" Header=" 📊 Laporan Penjualan " FontSize="14" FontWeight="Bold">
                    <views:LaporanView />
                </TabItem>

                <!-- Tab 3: Manajemen Produk -->
                <TabItem x:Name="TabProduk" Header=" 📦 Data Produk " FontSize="14" FontWeight="Bold">
                    <views:ProdukView />
                </TabItem>

                <TabItem x:Name="TabAuditLog" Header="📋 Audit Log &amp; Sesi Kasir">
                    <views:AuditLogView />
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</Window>